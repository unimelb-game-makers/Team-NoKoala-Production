[gd_scene format=3]

[ext_resource type="Script" path="res://features/factory_system/machines/ui/blueprint_panel.gd" id="1_panel"]

[node name="BlueprintPanel" type="VBoxContainer" node_paths=PackedStringArray("name_label", "construction_time_label", "materials_list", "progress_bar", "status_label")]
theme_override_constants/separation = 8
script = ExtResource("1_panel")
name_label = NodePath("Name")
construction_time_label = NodePath("ConstructionTime")
materials_list = NodePath("Materials/List")
progress_bar = NodePath("Progress")
status_label = NodePath("Status")
