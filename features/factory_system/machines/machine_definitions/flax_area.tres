[gd_resource type="Resource" script_class="MachineDefinition" format=3]

[ext_resource type="Script" path="res://features/factory_system/machines/machine_definitions/machine_cell_definition.gd" id="1_cell"]
[ext_resource type="Script" path="res://features/factory_system/machines/machine_definitions/machine_definition.gd" id="2_definition"]
[ext_resource type="Script" path="res://features/factory_system/recipes/recipe_item_amount.gd" id="3_amount"]
[ext_resource type="Resource" path="res://features/factory_system/factory_items/item_definitions/iron_ore.tres" id="4_iron"]

[sub_resource type="Resource" id="Resource_structure"]
script = ExtResource("1_cell")
port_id = &""
role = 2

[sub_resource type="Resource" id="Resource_output"]
script = ExtResource("1_cell")
port_id = &"output_1"
role = 1
local_cell_offset = Vector3i(0, 0, 1)
can_overlap = true

[sub_resource type="Resource" id="Resource_construction_iron"]
script = ExtResource("3_amount")
item = ExtResource("4_iron")

[resource]
script = ExtResource("2_definition")
machine_name = &"Flax Patch"
cells = Array[ExtResource("1_cell")]([SubResource("Resource_structure"), SubResource("Resource_output")])
construction_materials = Array[ExtResource("3_amount")]([SubResource("Resource_construction_iron")])
